{
  "statusLine": {
    "type": "command",
    "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/harness/bin/statusline\""
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bd prime --hook-json",
            "type": "command"
          }
        ],
        "matcher": ""
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "async": true,
            "command": "bash \"${CLAUDE_PROJECT_DIR}/harness/bin/hx\" otel start >/dev/null 2>&1"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/harness/bin/hx\" ingest >/dev/null 2>&1; bash \"${CLAUDE_PROJECT_DIR}/harness/bin/hx\" worker tick >/dev/null 2>&1",
            "async": true
          }
        ],
        "matcher": ""
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "async": true,
            "command": "bash \"${CLAUDE_PROJECT_DIR}/harness/bin/hx\" worker enqueue session_end --hook >/dev/null 2>&1; bash \"${CLAUDE_PROJECT_DIR}/harness/bin/hx\" worker start >/dev/null 2>&1"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/harness/bin/rtk-hook\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "OTEL_METRICS_EXPORTER": "otlp",
    "OTEL_LOGS_EXPORTER": "otlp",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "http/json",
    "OTEL_EXPORTER_OTLP_ENDPOINT": "http://127.0.0.1:4318",
    "OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE": "delta"
  },
  "permissions": {
    "allow": [
      "Bash(harness/bin/hx godot test *)",
      "Bash(hx godot test *)",
      "Bash(harness/bin/hx godot check *)",
      "Bash(hx godot check *)",
      "Bash(harness/bin/hx status)",
      "Bash(hx status)",
      "Bash(harness/bin/hx status *)",
      "Bash(hx status *)",
      "Bash(harness/bin/hx worker status *)",
      "Bash(hx worker status *)",
      "Bash(harness/bin/hx gateway status *)",
      "Bash(hx gateway status *)",
      "Bash(harness/bin/hx swarm status *)",
      "Bash(hx swarm status *)",
      "Bash(harness/bin/hx swarm workers *)",
      "Bash(hx swarm workers *)",
      "Bash(harness/bin/hx swarm usage *)",
      "Bash(hx swarm usage *)",
      "Bash(harness/bin/hx bonsai status *)",
      "Bash(hx bonsai status *)",
      "Bash(harness/bin/hx doctor *)",
      "Bash(hx doctor *)",
      "Bash(harness/bin/hx providers *)",
      "Bash(hx providers *)",
      "Bash(harness/bin/hx sim list *)",
      "Bash(hx sim list *)",
      "Bash(harness/bin/hx bench list *)",
      "Bash(hx bench list *)",
      "Bash(harness/bin/hx bench report *)",
      "Bash(hx bench report *)",
      "Bash(harness/bin/hx factory report *)",
      "Bash(hx factory report *)",
      "Bash(uv run --project harness pytest *)",
      "Bash(bd show *)",
      "Bash(bd list *)",
      "Bash(bd ready)",
      "Bash(bd ready *)",
      "Bash(bd search *)"
    ]
  }
}
