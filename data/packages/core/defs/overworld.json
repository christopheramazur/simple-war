	{"id": "band_caravan", "kind": "band", "values": {
		"name": "Caravan", "sight": 3, "movement_points": 30, "payload_stats": ["sight"], "caps": {"sight": 2}}},

	{"id": "preset_recon", "kind": "battleforce_preset", "values": {
