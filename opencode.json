{
  "$schema": "https://opencode.ai/config.json",
  "model": "hx/bonsai/nothink",
  "provider": {
    "hx": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "hx gateway (local LiteLLM; budgets + logging)",
      "options": {
        "baseURL": "http://127.0.0.1:4000/v1",
        "apiKey": "{env:HX_GATEWAY_KEY}"
      },
      "models": {
        "bonsai/nothink": {
          "name": "Bonsai 2 27B (no thinking)",
          "limit": { "context": 131072, "output": 8192 }
        },
        "bonsai/think": {
          "name": "Bonsai 2 27B (thinking)",
          "limit": { "context": 131072, "output": 16384 }
        }
      }
    }
  },
  "permission": {
    "bash": {
      "*": "allow",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git rebase*": "deny",
      "git reset --hard*": "deny",
      "git filter-branch*": "deny"
    }
  }
}
